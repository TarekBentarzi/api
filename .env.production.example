# Environnement de Production
# Copiez ce fichier en .env.production et configurez vos URLs de production

# PostgreSQL Local (Dev only)
POSTGRES_USER=dev
POSTGRES_PASSWORD=dev
POSTGRES_DB=qlearn_dev
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Supabase Production URLs
# Transaction mode (pooler) - Pour les requetes normales
DATABASE_URL=postgresql://postgres.gdbpgdqnpxzqbhperlhx:QlearnProject2026@aws-1-eu-central-1.pooler.supabase.com:5432/postgres

# Session mode (direct) - Pour les migrations Prisma
DIRECT_URL=postgresql://postgres.gdbpgdqnpxzqbhperlhx:QlearnProject2026@aws-1-eu-central-1.pooler.supabase.com:6543/postgres?pgbouncer=true

# JWT Secret pour l'authentification
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# Node Environment
NODE_ENV=production

# API Configuration
PORT=3000
API_PREFIX=api

# CORS Origins (separees par des virgules)
CORS_ORIGINS=https://votre-app.vercel.app,https://www.votre-domaine.com
